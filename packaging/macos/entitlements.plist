<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Notarized apps run with the hardened runtime, which blocks audio
	     input (the radio's USB sound card and the computer mic) unless asked for. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
